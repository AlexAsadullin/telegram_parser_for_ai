# Получить на https://my.telegram.org -> API development tools
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Пути ниже опциональные. Относительные пути резолвятся от корня проекта,
# абсолютные используются как есть.
TG_SESSION=backend/session/anon
DATA_DIR=data
DB_PATH=backend/history.db

# Локальное распознавание речи для личных сообщений (faster-whisper).
# Модель качается автоматически при первой транскрибации.
# Варианты: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Сколько сообщений личного чата обрабатывается за один чанк
DM_CHUNK_SIZE=200
